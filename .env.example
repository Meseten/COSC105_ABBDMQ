# ================================================
# PantryPal environment variables (SAMPLE ONLY)
# Copy this file to `.env.local` and fill in real
# values there. NEVER commit .env.local to GitHub.
# ================================================

# --- Google Gemini (REQUIRED, server-only) ---
# Get a key at https://aistudio.google.com/apikey
# This key is used only inside API routes; it must
# start with GEMINI_ so Next.js keeps it server-side.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase (OPTIONAL, browser-safe) ---
# These are the PUBLIC anon credentials from your
# Supabase project: Settings > API > Project URL and anon/publishable key.
# They are safe to expose to browsers; data is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
